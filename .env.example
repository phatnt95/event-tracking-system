# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=baby_tracker
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baby_tracker?schema=public"

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@babytracker.com
PGADMIN_DEFAULT_PASSWORD=adminpassword

# Authentication Configuration
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production
JWT_REFRESH_EXPIRES_IN=7d
